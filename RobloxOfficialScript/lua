-- Redyn Secure Script Loader Remover
-- Paste this into your Roblox executor to instantly remove the loading screen

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local function findAndDestroyLoader(parent)
    for _, child in pairs(parent:GetChildren()) do
        if child:IsA("ScreenGui") then
            for _, descendant in pairs(child:GetDescendants()) do
                if (descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox")) then
                    local text = string.lower(descendant.Text)
                    if text:find("secure script") or 
                       text:find("loader") and text:find("script") or
                       text:find("escape tsunami") or 
                       text:find("brainrot") or 
                       text:find("prepar") and text:find("environ") or
                       text:find("redyn") or
                       text:find("discord.gg") then
                        child:Destroy()
                        print("Removed loader GUI!")
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- Check CoreGui and PlayerGui
if not findAndDestroyLoader(CoreGui) then
    findAndDestroyLoader(PlayerGui)
end

-- Optional: Keep checking every second in case it recreates
spawn(function()
